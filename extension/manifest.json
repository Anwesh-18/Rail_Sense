{
  "manifest_version": 3,
  "name": "Burnt Mail & Stealth Form Automator",
  "version": "1.0.0",
  "description": "Single-use burnt email provisioning, stealth form filling, and OTP auto-extraction.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}